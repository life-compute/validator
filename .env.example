# ──────────────────────────────────────────────────────────────
#  LIFE Compute Validator — environment configuration
#  Copy to .env and edit the keypair paths. All other values
#  have working defaults for devnet and can be left as-is.
# ──────────────────────────────────────────────────────────────

# On-chain program address (devnet)
PROGRAM_ID=74RHjg1zYgN9zuVykde4SK2ERiRgNkouATW9MmQDLRWf

# Solana RPC endpoint
SOLANA_RPC=https://api.devnet.solana.com

# Path to your validator keypair JSON (output of: solana-keygen new)
VALIDATOR_KEYPAIR=~/.life-compute/wallet.json

# Fee-payer keypair — usually the same as VALIDATOR_KEYPAIR
PAYER_KEYPAIR=~/.life-compute/wallet.json

# Polling interval in seconds
POLL_SECONDS=30

# URL of the cancer target list (default: targets repo on GitHub)
TARGETS_URL=https://raw.githubusercontent.com/life-compute/targets/master/targets.json

# Directory containing Boltz2 MSA files (.a3m per UniProt ID)
MSA_DIR=./data/msa_files

# Path to life-compute/core checkout (for the program IDL)
ANCHOR_DIR=/tmp/life-compute/core

# Lock validation to a single miner's wallet address.
# Leave empty (default) to validate all miners — this is the correct mode
# for a public validator. Only set this for private/testing use.
MINER_WALLET=

# GPU model string — the daemon auto-detects and writes this on first run.
# You can pre-set it here if auto-detection fails (e.g. in Docker).
# Example: MINER_GPU_MODEL=RTX 4090
MINER_GPU_MODEL=
